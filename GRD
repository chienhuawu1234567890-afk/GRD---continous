for(i in seq_along(configs)) {
 cfg<-configs[[i]]
 cp<-file.path(outdir,paste0(cfg$id,".rds"))
 if(file.exists(cp)) {
   res<-readRDS(cp)
   if(!identical(res$version,VERSION_TAG) ||
      !identical(res$Bcal,Bcal) || !identical(res$Meval,Meval) ||
      !identical(res$Bbrown,Bbrown))
     stop("Checkpoint incompatible: ",cp)
   cat(sprintf("Resume %d/%d %s\n",i,length(configs),cfg$id))
 } else {
   cat(sprintf("Case %d/%d: %s; Bcal=%d; Meval=%d\n",
      i,length(configs),cfg$id,Bcal,Meval));flush.console()
   t<-cfg$looks/cfg$N
   brown<-get_brownian(cfg)
   seed_cal<-1000000L+i*1000L
   seed_null<-2000000L+i*1000L
   seed_alt<-3000000L+i*1000L
   Wcal<-simulate_paths(cfg,Bcal,seed_cal)
   fitted<-lapply(seq_along(methods),function(j)
       calibrate_method(matrix(Wcal[,,j],Bcal,length(t)),t,methods[j]))
   names(fitted)<-methods
   rm(Wcal);invisible(gc(verbose=FALSE))
   # Strictly independent evaluation replicates, paired across methods.
   Wnull<-simulate_paths(cfg,Meval,seed_null)
   alt<-cfg
   alt$Delta<-if(grepl("^IBS_",cfg$id)) .47 else .5
   alt$delta<-seq(0,alt$Delta,length.out=cfg$g)
   Walt<-simulate_paths(alt,Meval,seed_alt)
   metrics<-list();disagreement<-list();a<-0L;d<-0L
   for(hypothesis in c("null","alternative")) {
     W<-if(hypothesis=="null") Wnull else Walt
     seed<-if(hypothesis=="null") seed_null else seed_alt
     for(j in seq_along(methods)) for(scheme in c("Brownian","MethodSpecificFS")) {
       b<-if(scheme=="Brownian") brown else fitted[[j]]$b
       a<-a+1L
       metrics[[a]]<-metric_row(if(hypothesis=="null") cfg else alt,
          methods[j],scheme,matrix(W[,,j],Meval,length(t)),b,hypothesis,seed)
     }
     for(scheme in c("Brownian","MethodSpecificFS")) {
       bgrd<-if(scheme=="Brownian") brown else fitted[["GRD"]]$b
       bconv<-if(scheme=="Brownian") brown else fitted[["Conventional"]]$b
       bori<-if(scheme=="Brownian") brown else fitted[["Original_IPW"]]$b
       dg<-decide_paths(matrix(W[,,1],Meval,length(t)),bgrd,cfg$looks)$reject
       dc<-decide_paths(matrix(W[,,3],Meval,length(t)),bconv,cfg$looks)$reject
       do<-decide_paths(matrix(W[,,2],Meval,length(t)),bori,cfg$looks)$reject
       for(reference in c("Conventional","Original_IPW")) {
         ref<-if(reference=="Conventional") dc else do
         delta<-dg-ref
         d<-d+1L
         disagreement[[d]]<-data.frame(case=cfg$id,hypothesis=hypothesis,
           boundary=scheme,comparison=paste("GRD vs",reference),
           disagreement=mean(delta!=0),GRD_only=mean(delta==1),
           reference_only=mean(delta==-1),paired_difference=mean(delta),
           M=Meval)
       }
     }
   }
   bounds<-do.call(rbind,lapply(seq_along(methods),function(j) {
      fit<-fitted[[j]]
      data.frame(case=cfg$id,method=methods[j],look=seq_along(t),
       information_fraction=t,Brownian=brown,FiniteSample=fit$b,
       calibration_seed=seed_cal,Bcal=Bcal,
       fit$diagnostics[,c("target_increment","achieved_increment",
       "survivors","calibration_rejections","infeasible","calibration_mcse")])
   }))
   res<-list(version=VERSION_TAG,Bcal=Bcal,Meval=Meval,Bbrown=Bbrown,
     metrics=do.call(rbind,metrics),boundaries=bounds,
     disagreements=do.call(rbind,disagreement))
   saveRDS(res,cp)
   rm(Wnull,Walt);invisible(gc(verbose=FALSE))
 }
 all_metrics[[i]]<-res$metrics
 all_boundaries[[i]]<-res$boundaries
 all_disagreement[[i]]<-res$disagreements
 # Persist aggregated CSVs after EVERY case for interrupted runs.
 write.csv(do.call(rbind,all_metrics),
   file.path(outdir,"validation_metrics.csv"),row.names=FALSE)
