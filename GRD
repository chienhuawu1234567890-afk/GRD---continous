          wilson(960,20000)[2] > 0.048,
          wilson(0,200)[1] >= 0,
          wilson(200,200)[2] <= 1+1e-12)

spend <- function(t) ifelse(t<=0,0,2*pnorm(-qnorm(1-alpha/2)/sqrt(t)))

# Calibration is independent of evaluation seeds.
# Omnibus d-dimensional Brownian statistic is ||B_d(t)||^2/t, not Z^2 for d>1.
calibrate <- function(d,t,B,seed) {
  set.seed(seed); K<-length(t); boundaries<-numeric(K)
  alive<-rep(TRUE,B); state<-matrix(0,B,d); prev<-0
  diagnostics<-vector('list',K)
  for(k in seq_len(K)) {
    state<-state+matrix(rnorm(B*d,sd=sqrt(t[k]-prev)),B,d)
    w<-rowSums(state^2)/t[k]
    increment<-spend(t[k])-spend(prev)
    survivors<-sum(alive)
    prob<-increment/(survivors/B)
    if(prob>=1) stop('Spending increment exceeds surviving probability')
    if(prob<=0) boundaries[k]<-Inf else {
      boundaries[k]<-unname(quantile(w[alive],1-prob,type=1))
    }
    crossing<-alive & (w>=boundaries[k])
    achieved<-mean(crossing)
    diagnostics[[k]]<-data.frame(look=k,information_fraction=t[k],
       target_increment=increment,achieved_increment=achieved,
       calibration_mcse=sqrt(achieved*(1-achieved)/B),
       surviving_paths=survivors,boundary=boundaries[k])
    alive[crossing]<-FALSE;prev<-t[k]
  }
  list(boundaries=boundaries,diagnostics=do.call(rbind,diagnostics))
}

# Independent validation paths, separate from boundary-fitting paths.
validate_boundaries <- function(d,t,b,B,seed) {
  set.seed(seed); K<-length(t); alive<-rep(TRUE,B)
  state<-matrix(0,B,d); prev<-0
  rows<-vector('list',K)
  for(k in seq_len(K)) {
    state<-state+matrix(rnorm(B*d,sd=sqrt(t[k]-prev)),B,d)
    w<-rowSums(state^2)/t[k]
    crossing<-alive & w>=b[k]
    rate<-mean(crossing); ci<-wilson(sum(crossing),B)
    rows[[k]]<-data.frame(look=k,validation_increment=rate,
       validation_mcse=sqrt(rate*(1-rate)/B),
       validation_ci_low=ci[1],validation_ci_high=ci[2],
       validation_paths=B)
    alive[crossing]<-FALSE;prev<-t[k]
  }
  z<-do.call(rbind,rows)
  z$validation_overall<-sum(z$validation_increment)
  z$validation_overall_mcse<-sqrt(z$validation_overall*(1-z$validation_overall)/B)
  total_ci<-wilson(sum(round(z$validation_increment*B)),B)
  z$validation_overall_ci_low<-total_ci[1]
  z$validation_overall_ci_high<-total_ci[2]
  z
}

# Contrasts against the last treatment arm (placebo/reference).
contrast_matrix <- function(g) cbind(diag(g-1),-rep(1,g-1))

# At every scheduled look, even if the sequential procedure stops earlier,
# calculate fixed-look estimates, estimated SE and ordinary 95% CI coverage.
# The latter are NOT confidence intervals valid at a random stopping time.
wald_ipw <- function(X,looks,C) {
  K<-length(looks);d<-nrow(C)
  W<-rep(NA_real_,K); contrasts<-matrix(NA_real_,K,d)
  se<-matrix(NA_real_,K,d); failed<-rep(FALSE,K)
  for(k in seq_len(K)) {
    n<-looks[k];x<-X[seq_len(n),,drop=FALSE]
    means<-colMeans(x)
    v<-crossprod(sweep(x,2,means,'-'))/(n-1)
    h<-C%*%v%*%t(C)
    contrasts[k,]<-as.vector(C%*%means)
    diag_h<-diag(h)
    se[k,]<-sqrt(pmax(0,diag_h/n))
    eig<-tryCatch(eigen(h,symmetric=TRUE,only.values=TRUE)$values,
                  error=function(e) rep(NA_real_,d))
    if(any(!is.finite(eig)) || min(eig)<=0 || min(eig)<=max(eig)*1e-10) {
      failed[k]<-TRUE;next
    }
    vct<-contrasts[k,]
    W[k]<-tryCatch(as.numeric(n*crossprod(vct,solve(h,vct))),
                   error=function(e) NA_real_)
    if(!is.finite(W[k]) || W[k]<0) {W[k]<-NA_real_;failed[k]<-TRUE}
  }
  list(W=W,contrasts=contrasts,se=se,failed=failed,empty=rep(FALSE,K))
}

wald_conventional <- function(A,Y,looks,g,C) {
  K<-length(looks);d<-nrow(C)
  W<-rep(NA_real_,K); contrasts<-matrix(NA_real_,K,d)
  se<-matrix(NA_real_,K,d);failed<-rep(FALSE,K);empty<-rep(FALSE,K)
  for(k in seq_len(K)) {
    idx<-seq_len(looks[k]);groups<-split(Y[idx],factor(A[idx],levels=seq_len(g)))
    ns<-lengths(groups);empty[k]<-any(ns==0)
    if(any(ns<2)) {failed[k]<-TRUE;next}
    means<-vapply(groups,mean,0.0)
    vv<-vapply(groups,var,0.0)/ns
    h<-C%*%diag(vv,g)%*%t(C)
    contrasts[k,]<-as.vector(C%*%means)
    se[k,]<-sqrt(pmax(0,diag(h)))
    eig<-tryCatch(eigen(h,symmetric=TRUE,only.values=TRUE)$values,
                  error=function(e) rep(NA_real_,d))
    if(any(!is.finite(eig)) || min(eig)<=0 || min(eig)<=max(eig)*1e-10) {
      failed[k]<-TRUE;next
    }
    vct<-contrasts[k,]
    W[k]<-tryCatch(as.numeric(crossprod(vct,solve(h,vct))),
                   error=function(e) NA_real_)
    if(!is.finite(W[k]) || W[k]<0) {W[k]<-NA_real_;failed[k]<-TRUE}
  }
  list(W=W,contrasts=contrasts,se=se,failed=failed,empty=empty)
}

outcomes <- function(A,delta,m,sigma,model) {
  n<-length(A)
  noise<-switch(model,normal=rnorm(n),
     heavy=rt(n,5)*sqrt(3/5),
     skew=(exp(rnorm(n))-exp(.5))/sqrt(exp(2)-exp(1)),
     stop('Unknown model'))
  m+delta[A]+sigma[A]*noise
}

# PRE-SPECIFIED FAILURE-HANDLING POLICY (v8):
# If a covariance/Wald calculation fails at a scheduled look, there is NO
# efficacy rejection at that look; monitoring continues to the next look.
# If the final look fails, the simulated decision is no efficacy rejection.
# In an actual trial, this is an UNRESOLVED ANALYSIS requiring independent
# DMC/statistician escalation, not evidence of absence of a treatment effect.
# No replicate is discarded. This rule defines the PRIMARY finite-sample
# algorithm; the failure-union bound is a separate sensitivity diagnostic.
# Results at looks after an earlier efficacy stop are calculated ONLY for
# fixed-look calibration, not for the operational failure rate.
decision <- function(W,b,looks,failed) {
  stopifnot(length(W)==length(b),length(b)==length(looks),
            length(failed)==length(W),all(!is.na(failed)))
  # Defensive: any nonfinite statistic is a failure, not a hidden zero.
  failed <- as.logical(failed | !is.finite(W))
  eligible <- which(!failed & W>=b)
  k <- if(length(eligible)) eligible[1] else 0L
  reached <- seq_len(if(k>0L) k else length(looks))
  failed_reached <- any(failed[reached])
  c(reject=as.integer(k>0L),stoplook=k,
    nstop=if(k>0L) looks[k] else tail(looks,1),
    early=as.integer(k==1L),finalonly=as.integer(k==length(looks)),
    failed_reached=as.integer(failed_reached),
    failed_final_reached=as.integer(k==0L && failed[length(looks)]),
    unresolved=as.integer(k==0L && failed[length(looks)]))
}
# Unit checks for failure policy: early failure, late success; final failure;
# efficacy stop before an irrelevant later failure.
stopifnot(decision(c(NA,12),c(10,10),c(50,100),c(TRUE,FALSE))['reject']==1,
          decision(c(NA,12),c(10,10),c(50,100),c(TRUE,FALSE))['nstop']==100,
          decision(c(NA,NA),c(10,10),c(50,100),c(TRUE,TRUE))['unresolved']==1,
          decision(c(12,NA),c(10,10),c(50,100),c(FALSE,TRUE))['failed_reached']==0)


make_cfg <- function(id,g,N,eta,model="normal",m=0,Delta=0,K=2,
                     sigma=NULL,p=NULL) {
 if(is.null(p)) p <- if(g==3) c(1/6,1/3,1/2) else rep(1/g,g)
 if(is.null(sigma)) sigma <- rep(1,g)
 stopifnot(length(p)==g,length(sigma)==g,all(p>0),abs(sum(p)-1)<1e-9,
           N>=g*3,eta>=0,eta<1)
 looks <- unique(as.integer(round(seq_len(K)*N/K)))
 stopifnot(length(looks)==K,tail(looks,1)==N)
 list(id=id,g=g,N=N,eta=eta,model=model,m=m,Delta=Delta,
      delta=seq(0,Delta,length.out=g),looks=looks,sigma=sigma,p=p)
}
