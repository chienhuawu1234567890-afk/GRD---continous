# The IBS alternative below is explicitly calibrated to m=-0.58,
# Delta=0.47 and delta=(0,0.235,0.47), NOT observed patient-level data.
# No claim that these are Whorwell trial's observed treatment means.
# All other alternatives use Delta=0.5.
# Generate each case's alternative from its matching null cfg.

simulate_paths <- function(cfg,M,seed) {
 set.seed(seed)
 g<-cfg$g; N<-cfg$N; K<-length(cfg$looks); C<-contrast_matrix(g)
 Q<-routing(cfg$p,cfg$eta)
 mr<-diag(1/cfg$p,g)%*%solve(Q)
 mo<-diag(1/cfg$p,g)
 W <- array(NA_real_,dim=c(M,K,3),
            dimnames=list(NULL,NULL,c("GRD","Original_IPW","Conventional")))
 for(r in seq_len(M)) {
   A<-sample.int(g,N,replace=TRUE,prob=cfg$p)
   Y<-outcomes(A,cfg$delta,cfg$m,cfg$sigma,cfg$model)
   U<-runif(N); Ast<-integer(N)
   for(i in seq_len(g)) {
     ix<-which(A==i)
     if(length(ix)) Ast[ix]<-findInterval(U[ix],
         c(0,cumsum(Q[,i])),rightmost.closed=TRUE)
   }
   stopifnot(all(Ast>=1L&Ast<=g))
   Xr<-t(mr[,Ast,drop=FALSE])*Y
   Xo<-t(mo[,A,drop=FALSE])*Y
   W[r,,1]<-wald_ipw(Xr,cfg$looks,C)$W
   W[r,,2]<-wald_ipw(Xo,cfg$looks,C)$W
   W[r,,3]<-wald_conventional(A,Y,cfg$looks,g,C)$W
 }
 W
}


# Brownian omnibus boundaries (dimension g-1), cached by look schedule.
brownian_cache <- new.env(parent=emptyenv())
get_brownian <- function(cfg) {
 t <- cfg$looks/cfg$N
 key <- paste(cfg$g,paste(format(t,digits=12),collapse="_"),sep="_")
 if(!exists(key,brownian_cache,inherits=FALSE)) {
   seed <- 50000L+sum(utf8ToInt(key))
   b <- calibrate(cfg$g-1,t,Bbrown,seed)$boundaries
   assign(key,b,brownian_cache)
 }
 get(key,brownian_cache,inherits=FALSE)
}

# Quantile calibration based on first-crossing probabilities.  Nonfinite
# statistics are non-rejections; no replicate is silently dropped.
# At very small B, discrete quantiles cannot achieve exact spending.
calibrate_method <- function(W,t,method) {
 stopifnot(is.matrix(W),ncol(W)==length(t))
 B<-nrow(W);K<-ncol(W);alive<-rep(TRUE,B)
 boundaries<-rep(Inf,K);prev<-0
 records<-vector("list",K)
 for(k in seq_len(K)) {
   target<-spend(t[k])-spend(prev)
   surv<-mean(alive)
   q<-target/surv
   if(!is.finite(q)||q<=0||q>=1) stop("Invalid conditional spending")
   x<-W[alive,k];x[!is.finite(x)]<--Inf
   finite_x<-x[is.finite(x)]
   # If finite values cannot achieve target probability, flag infeasibility.
   infeasible <- mean(is.finite(x)) < q
   if(!infeasible) boundaries[k]<-unname(quantile(x,1-q,type=1))
   crossing<-alive & is.finite(W[,k]) & W[,k]>=boundaries[k]
   achieved<-mean(crossing)
   records[[k]]<-data.frame(method=method,look=k,
       target_increment=target,achieved_increment=achieved,
       survivors=sum(alive),calibration_rejections=sum(crossing),
       infeasible=infeasible,
       calibration_mcse=sqrt(achieved*(1-achieved)/B))
   alive[crossing]<-FALSE;prev<-t[k]
 }
 list(b=boundaries,diagnostics=do.call(rbind,records))
}

decide_paths <- function(W,b,looks) {
 stopifnot(is.matrix(W),length(b)==ncol(W),length(looks)==ncol(W))
 M<-nrow(W);K<-ncol(W)
 crossing<-sweep(W,2,b,">=") & is.finite(W)
 first<-max.col(crossing,ties.method="first")
 anycross<-rowSums(crossing)>0L
 first[!anycross]<-0L
 # If first efficacy stop occurs, later look failures are not operational.
 nstop<-ifelse(anycross,looks[pmax(first,1L)],tail(looks,1))
 fail<-!is.finite(W)
 reached_failure<-vapply(seq_len(M),function(i) {
   last<-if(first[i]>0L) first[i] else K
   any(fail[i,seq_len(last)])
 },logical(1))
 data.frame(reject=as.integer(anycross),
            early=as.integer(first==1L),
            nstop=nstop,
            failed_reached=as.integer(reached_failure),
            unresolved=as.integer(first==0L & fail[,K]))
}

metric_row <- function(cfg,method,scheme,W,b,hypothesis,seed) {
 d<-decide_paths(W,b,cfg$looks);M<-nrow(d);k<-sum(d$reject)
 ci<-wilson(k,M)
 data.frame(case=cfg$id,hypothesis=hypothesis,method=method,
  boundary=scheme,g=cfg$g,N=cfg$N,K=length(cfg$looks),
  eta=cfg$eta,model=cfg$model,m=cfg$m,Delta=cfg$Delta,
  M=M,seed=seed,rejections=k,rejection_rate=k/M,
  mcse=sqrt((k/M)*(1-k/M)/M),
  ci_low=ci[1],ci_high=ci[2],early=mean(d$early),
  ESS=mean(d$nstop),ESS_mcse=sd(d$nstop)/sqrt(M),
  failed_reached=mean(d$failed_reached),
  unresolved=mean(d$unresolved))
}
