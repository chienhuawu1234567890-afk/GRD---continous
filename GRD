   file.path(outdir,"calibrated_boundaries.csv"),row.names=FALSE)
 write.csv(do.call(rbind,all_disagreement),
   file.path(outdir,"paired_disagreement.csv"),row.names=FALSE)
}
manifest<-do.call(rbind,lapply(configs,function(x)
 data.frame(case=x$id,g=x$g,N=x$N,K=length(x$looks),
 eta=x$eta,model=x$model,m=x$m,
 p=paste(x$p,collapse=";"),sigma=paste(x$sigma,collapse=";"),
 looks=paste(x$looks,collapse=";"))))
write.csv(manifest,file.path(outdir,"scenario_manifest.csv"),row.names=FALSE)
summary<-subset(do.call(rbind,all_metrics),hypothesis=="null")
summary<-summary[,c("case","method","boundary","rejection_rate","mcse",
                      "ci_low","ci_high","failed_reached","unresolved")]
write.csv(summary,file.path(outdir,"null_validation_summary.csv"),row.names=FALSE)
cat("\nComplete. Output directory:",normalizePath(outdir),"\n")
