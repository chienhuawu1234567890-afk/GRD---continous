# L-RRM versus Parametric Synthetic Data, v8. Base R only; source() executes.
# Comparison outputs use the v7-compatible core simulation with matched empirical risk and frontier analysis.
# Public: fixed X, treatment, visit schedule, oracle V and beta (oracle benchmarks).
# Private: outcomes Y. Plug-in releases are NOT differentially private.
options(stringsAsFactors=FALSE)
getnum <- function(k,d) as.numeric(Sys.getenv(k,as.character(d)))
getint <- function(k,d) as.integer(getnum(k,d))
getbool <- function(k,d=FALSE) tolower(Sys.getenv(k,if(d)'true' else 'false')) %in% c('true','yes','1')
SEED<-getint('LRRM_SEED',20261105); REPS<-getint('LRRM_REPS',5000)
FULL<-getbool('LRRM_FULL'); OUT<-Sys.getenv('LRRM_OUT','LRRM_v8_results')
BATCH<-getint('LRRM_BATCH',25); BOOT<-getint('LRRM_BOOT',200)
BOOT_EVERY<-getint('LRRM_BOOT_EVERY',10); PRIV_EVERY<-getint('LRRM_PRIV_EVERY',10)
RESUME<-getbool('LRRM_RESUME',TRUE); EPS<-getnum('LRRM_DP_EPS',0.9)
DELTA<-getnum('LRRM_DP_DELTA',1e-5); CLIP_Y<-getnum('LRRM_DP_CLIP',10)
CLIP_SCORE<-getnum('LRRM_SCORE_CLIP',10)
# Sensitivity study is a separate collection of ALTERNATIVE DP releases.
DP_SENS<-getbool('LRRM_DP_SENS',TRUE)
DP_EVERY<-getint('LRRM_DP_EVERY',10)
parse_grid<-function(k,default) {
  v<-as.numeric(strsplit(Sys.getenv(k,default),',',fixed=TRUE)[[1]])
  if(!length(v)||any(!is.finite(v)))stop('Invalid numeric grid: ',k)
  unique(v)
}
EPS_GRID<-parse_grid('LRRM_EPS_GRID','0.3,0.5,0.9')
CLIP_GRID<-parse_grid('LRRM_CLIP_GRID','5,10,20')
# AUC matching is empirical, NOT formal DP equivalence.
AUC_TOL<-getnum('LRRM_AUC_TOL',0.02)
# Sensitivity generators shrink fitted within-patient covariance toward its diagonal.
# These are deliberately different parametric generators; not DP and not oracle exact.
SYN_SHRINK<-parse_grid('LRRM_SYN_SHRINK','0,0.25,0.5')
if(any(SYN_SHRINK<0|SYN_SHRINK>1) || !any(SYN_SHRINK==0) ||
   !is.finite(AUC_TOL) || AUC_TOL<=0 || AUC_TOL>0.5)
  stop('Invalid synthetic covariance shrinkage or AUC tolerance')

# Default: 5000 replicates per scenario, with bootstrap on every tenth replicate.
# Each of the 500 selected replicates uses 200 bootstrap draws per eligible method.
# Quick check: LRRM_REPS=10 LRRM_BOOT=30 LRRM_OUT=LRRM_smoke Rscript <script.R>

if(any(!is.finite(c(SEED,REPS,BATCH,BOOT,BOOT_EVERY,PRIV_EVERY,EPS,DELTA,CLIP_Y,CLIP_SCORE))) ||
   REPS<2 || BATCH<1 || BOOT<0 || (BOOT>0 && BOOT<30) || BOOT_EVERY<1 ||
   PRIV_EVERY<1 || DP_EVERY<1 || any(EPS_GRID<=0|EPS_GRID>=1) || any(CLIP_GRID<=0) || EPS<=0 || EPS>=1 || DELTA<=0 || DELTA>=1 ||
   CLIP_Y<=0 || CLIP_SCORE<=0) stop('Invalid configuration; classic Gaussian calibration requires 0<epsilon<1')
N_GRID<-if(FULL)c(100L,300L,500L,1000L) else c(100L,300L)
T_GRID<-if(FULL)c(3L,5L,10L) else 5L
GAMMA<-c(0,.25,.5,.75,1) # same grid in pilot and full runs
EFFECT<-c(0,.25); CORR<-if(FULL)c('AR1','CS') else 'AR1'
BETA_BASE<-c(1,.4,.3,0); D_RE<-matrix(c(.6,.12,.12,.15),2,2)
SIG<-.8; RHO<-.4; Z975<-qnorm(.975)
CAL_MULT<-sqrt(2*log(1.25/DELTA))/EPS
DP_Y_SD<-2*CLIP_Y*CAL_MULT; DP_SCORE_SD<-2*CLIP_SCORE*CAL_MULT
sym<-function(a)(a+t(a))/2
sqrtm<-function(a){e<-eigen(sym(a),symmetric=TRUE);if(min(e$values)< -1e-7)stop('Not PSD');
 e$vectors%*%diag(sqrt(pmax(e$values,0)),length(e$values))%*%t(e$vectors)}
make_V<-function(tt,corr){z<-cbind(1,tt);m<-length(tt)
 r<-if(corr=='AR1')SIG^2*RHO^abs(outer(seq_len(m),seq_len(m),'-')) else
   SIG^2*(RHO+(1-RHO)*diag(m));sym(z%*%D_RE%*%t(z)+r)}
make_design<-function(trt,tt)lapply(trt,function(a)cbind(1,tt,a,a*tt))
make_data<-function(n,T,effect,corr,trt=NULL,beta=NULL,V=NULL){tt<-seq(0,1,length.out=T)
 if(is.null(trt))trt<-sample(rep(c(0L,1L),length.out=n))
 if(is.null(beta)){beta<-BETA_BASE;beta[4]<-effect}
 if(is.null(V))V<-make_V(tt,corr)
 X<-make_design(trt,tt);mu<-t(vapply(X,function(x)drop(x%*%beta),numeric(T)))
 Y<-mu+matrix(rnorm(n*T),n,T)%*%t(sqrtm(V))
 list(Y=Y,mu=mu,X=X,V=V,trt=trt,tt=tt,beta=beta,corr=corr)}
replace_Y<-function(d,Y){d$Y<-Y;d}
gls<-function(d,Y,V){vi<-solve(V);h<-numeric(4);H<-matrix(0,4,4)
 for(i in seq_len(nrow(Y))){x<-d$X[[i]];H<-H+crossprod(x,vi%*%x)
  h<-h+drop(crossprod(x,vi%*%Y[i,]))}
 vc<-solve(H);list(beta=drop(vc%*%h),vcov=vc,H=H)}
fit_moments<-function(d){T<-ncol(d$Y);xx<-do.call(rbind,d$X)
 b<-drop(qr.solve(xx,as.vector(t(d$Y))))
 for(k in seq_len(3)){mu<-t(vapply(d$X,function(x)drop(x%*%b),numeric(T)))
  vv<-cov(d$Y-mu);ee<-eigen(sym(vv),symmetric=TRUE)
  vv<-sym(ee$vectors%*%diag(pmax(ee$values,1e-5),T)%*%t(ee$vectors))
  b<-gls(d,d$Y,vv)$beta}
 list(mu=t(vapply(d$X,function(x)drop(x%*%b),numeric(T))),V=vv,beta=b)}
release_lrrm<-function(d,g,mom){if(g==1)return(d$Y) # exact consistency
 mom$mu+g*(d$Y-mom$mu)+matrix(rnorm(length(d$Y)),nrow(d$Y))%*%
 t(sqrtm((1-g*g)*mom$V))}
release_syn<-function(d,mom,shrink=0){
  Vsyn <- (1-shrink)*mom$V + shrink*diag(diag(mom$V))
  mom$mu+matrix(rnorm(length(d$Y)),nrow(d$Y))%*%t(sqrtm(Vsyn))
}
row_norm<-function(x)sqrt(rowSums(x^2))
clip_rows<-function(x,B)x*pmin(1,B/pmax(row_norm(x),1e-12))
score_parts<-function(d){vi<-solve(d$V);n<-nrow(d$Y);scores<-matrix(0,n,4);H<-matrix(0,4,4)
 for(i in seq_len(n)){x<-d$X[[i]];scores[i,]<-drop(crossprod(x,vi%*%d$Y[i,]))
  H<-H+crossprod(x,vi%*%x)}
 list(scores=scores,H=H)}
# DP guarantees for one ALTERNATIVE output, replacement of ONE outcome trajectory
# at a fixed public design row. Clipping bounds L2 sensitivity by 2B.
release_dp_y<-function(d,B=CLIP_Y,epsilon=EPS){
 cl<-clip_rows(d$Y,B); noise_sd<-2*B*sqrt(2*log(1.25/DELTA))/epsilon
 list(Y=cl+matrix(rnorm(length(d$Y),sd=noise_sd),nrow(d$Y)),
  clipped=cl,noise_sd=noise_sd,rate=mean(row_norm(d$Y)>B),
  distortion=mean((cl-d$Y)^2))}

release_dp_score<-function(d,B=CLIP_SCORE,epsilon=EPS){
 s<-score_parts(d);cl<-clip_rows(s$scores,B)
 noise_sd<-2*B*sqrt(2*log(1.25/DELTA))/epsilon
 noise<-rnorm(4,sd=noise_sd);vc<-solve(s$H)
 beta<-drop(vc%*%(colSums(cl)+noise));
 # Working variance: un-clipped Gaussian sampling variance + calibrated noise.
 # Not generally exact after clipping; empirically validated below.
 vv<-vc+noise_sd^2*tcrossprod(vc)
 list(est=beta[4],se=sqrt(vv[4,4]),rate=mean(row_norm(s$scores)>B),
  distortion=mean((cl-s$scores)^2),
  clip_shift=drop(vc%*%colSums(cl-s$scores))[4],
  noise_beta_sd=noise_sd*sqrt(sum(vc[4,]^2)),noise_sd=noise_sd)}
# Fixed-design parametric bootstrap: generate a fresh confidential sample under
# fitted beta and V, refit moments, release anew, and re-estimate.
# It targets the fitted-model repeated-sampling SD, not a DP guarantee.
bootstrap_se<-function(d,method,g,B){mom0<-fit_moments(d);n<-nrow(d$Y);T<-ncol(d$Y)
 vals<-numeric(B);center<-t(vapply(d$X,function(x)drop(x%*%mom0$beta),numeric(T)))
 root<-sqrtm(mom0$V)
 for(b in seq_len(B)){db<-replace_Y(d,center+matrix(rnorm(n*T),n,T)%*%t(root))
  mb<-fit_moments(db)
  yb<-if(method=='lrrm_plugin')release_lrrm(db,g,mb) else release_syn(db,mb)
  vals[b]<-gls(db,yb,mb$V)$beta[4]}
 sd(vals)}
# Oracle and practical attackers differ only in auxiliary parameters.
# Practical attacker knows public beta baseline with zero interaction and public V.
# Candidate-specific mean used for members and holdouts (fixes v4 normalization).
features<-function(Y,mu,V)(Y-mu)%*%solve(sqrtm(V))
dist2<-function(A,B)pmax(outer(rowSums(A^2),rowSums(B^2),'+')-2*tcrossprod(A,B),0)
auc_score<-function(member,nonmember){n<-length(member);m<-length(nonmember)
 if(!n||!m)return(NA_real_)
 z<-rank(c(member,nonmember),ties.method='average')
 (sum(z[seq_len(n)])-n*(n+1)/2)/(n*m)}
attack_once<-function(d,Y,hold,kind,aux){
 bet<-if(aux=='oracle')d$beta else BETA_BASE
 mu_train<-t(vapply(d$X,function(x)drop(x%*%bet),numeric(ncol(d$Y))))
 mu_hold<-t(vapply(hold$X,function(x)drop(x%*%bet),numeric(ncol(d$Y))))
 A<-features(d$Y,mu_train,d$V);B<-features(Y,mu_train,d$V)
 H<-features(hold$Y,mu_hold,d$V)
 D1<-dist2(A,B);D0<-dist2(H,B)
 D1[outer(d$trt,d$trt,'!=')]<-Inf
 D0[outer(hold$trt,d$trt,'!=')]<-Inf
 nearest<-max.col(-D1,ties.method='first')
 sc1<- -apply(D1,1,min);sc0<- -apply(D0,1,min)
 c(linkage=if(kind=='lrrm')mean(nearest==seq_len(nrow(A))) else NA_real_,
  reconstruction=mean((d$Y-Y[nearest,,drop=FALSE])^2),
  membership_auc=auc_score(sc1,sc0))}
privacy_attack<-function(d,Y,hold,kind){a<-attack_once(d,Y,hold,kind,'oracle')
 b<-attack_once(d,Y,hold,kind,'practical')
 c(linkage_oracle=unname(a['linkage']),linkage_practical=unname(b['linkage']),
   reconstruction_oracle=unname(a['reconstruction']),reconstruction_practical=unname(b['reconstruction']),
   mia_auc_oracle=unname(a['membership_auc']),mia_auc_practical=unname(b['membership_auc']),
   paired_release_mse=if(kind=='lrrm')mean((d$Y-Y)^2) else NA_real_)}
PR_NAMES<-c('linkage_oracle','linkage_practical','reconstruction_oracle',
 'reconstruction_practical','mia_auc_oracle','mia_auc_practical','paired_release_mse')
make_row<-function(d,Y,method,g,r,s,mom,hold,do_boot,ref_plugin){
 isplug<-method=='lrrm_plugin'||grepl('^synthetic_plugin',method);isdp<-method=='dp_y'
 Vwork<-if(isplug)mom$V else if(isdp)d$V+diag(DP_Y_SD^2,ncol(d$Y)) else d$V
 f<-gls(d,Y,Vwork);est<-f$beta[4];se0<-sqrt(f$vcov[4,4])
 mult<-if(method=='lrrm_plugin')2-g*g else if(grepl('^synthetic_plugin',method))2 else 1
 se<-se0*sqrt(mult)
 sb<-if(isplug&&do_boot && method %in% c('lrrm_plugin','synthetic_plugin'))bootstrap_se(d,method,g,BOOT) else NA_real_
 pp<-setNames(rep(NA_real_,length(PR_NAMES)),PR_NAMES)
 if(method=='original')pp[c('linkage_oracle','linkage_practical','reconstruction_oracle',
   'reconstruction_practical','paired_release_mse')]<-c(1,1,0,0,0)
 else if(!is.null(hold)&&!isdp)pp<-privacy_attack(d,Y,hold,if(grepl('lrrm',method))'lrrm' else 'synthetic')
 consistency<-if(method=='lrrm_plugin'&&g==1)max(abs(f$beta-ref_plugin$beta)) else NA_real_
 if(is.finite(consistency)&&consistency>1e-9)stop('gamma=1 consistency failure')
  se_consistency<-if(method=='lrrm_plugin'&&g==1)
    abs(se-sqrt(ref_plugin$vcov[4,4])) else NA_real_
  if(is.finite(se_consistency)&&se_consistency>1e-9)stop('gamma=1 SE consistency failure')
 cbind(data.frame(scenario_id=s,n=nrow(d$Y),T=ncol(d$Y),beta3=d$beta[4],corr=d$corr,
  rep=r,gamma=g,method=method,estimate=est,se_analytic=se,se_boot=sb,
  reject=as.integer(abs(est/se)>Z975),cover=as.integer(abs(est-d$beta[4])<=Z975*se),
  reject_boot=if(is.finite(sb)&&sb>0)as.integer(abs(est/sb)>Z975) else NA_integer_,
  cover_boot=if(is.finite(sb)&&sb>0)as.integer(abs(est-d$beta[4])<=Z975*sb) else NA_integer_,
  gamma1_beta_maxdiff=consistency,gamma1_se_diff=se_consistency,
  clip_rate=NA_real_,clip_distortion=NA_real_,clip_beta_shift=NA_real_,
  dp_noise_sd=if(isdp)DP_Y_SD else NA_real_,dp_beta_noise_sd=NA_real_),
  as.data.frame(as.list(pp))) }
score_row<-function(d,r,s){z<-release_dp_score(d)
 cbind(data.frame(scenario_id=s,n=nrow(d$Y),T=ncol(d$Y),beta3=d$beta[4],corr=d$corr,
 rep=r,gamma=NA_real_,method='dp_score',estimate=z$est,se_analytic=z$se,se_boot=NA_real_,
 reject=as.integer(abs(z$est/z$se)>Z975),cover=as.integer(abs(z$est-d$beta[4])<=Z975*z$se),
 reject_boot=NA_integer_,cover_boot=NA_integer_,gamma1_beta_maxdiff=NA_real_,gamma1_se_diff=NA_real_,
 clip_rate=z$rate,clip_distortion=z$distortion,clip_beta_shift=z$clip_shift,
 dp_noise_sd=DP_SCORE_SD,dp_beta_noise_sd=z$noise_beta_sd),
 as.data.frame(as.list(setNames(rep(NA_real_,length(PR_NAMES)),PR_NAMES))))}
scenario_seed<-function(s,r)as.integer((as.double(SEED)+1000003*as.double(s)+7919*as.double(r))%%2147483646+1)
run_rep<-function(s,z,r){set.seed(scenario_seed(s,r));d<-make_data(z$n,z$T,z$beta3,z$corr)
 mom<-fit_moments(d);hold<-if(r%%PRIV_EVERY==0)make_data(z$n,z$T,z$beta3,z$corr) else NULL
 boot_now<-BOOT>0&&r%%BOOT_EVERY==0
 ref_plugin<-gls(d,d$Y,mom$V)
 add<-function(Y,method,g=NA_real_)make_row(d,Y,method,g,r,s,mom,hold,boot_now,ref_plugin)
 rr<-list();rr[[1]]<-add(d$Y,'original');rr[[2]]<-add(release_syn(d,list(mu=d$mu,V=d$V)),'synthetic_oracle')
 rr[[3]]<-add(release_syn(d,mom),'synthetic_plugin')
  for(sh in SYN_SHRINK[SYN_SHRINK>0]){
    nm<-sprintf('synthetic_plugin_shrink_%03d',round(100*sh))
    rr[[length(rr)+1L]]<-add(release_syn(d,mom,shrink=sh),nm)
  }
 dp<-release_dp_y(d);rr[[length(rr)+1L]]<-add(dp$Y,'dp_y')
 rr[[length(rr)]]$clip_rate<-dp$rate;rr[[length(rr)]]$clip_distortion<-dp$distortion
 rr[[length(rr)+1L]]<-score_row(d,r,s)
 for(g in GAMMA){rr[[length(rr)+1L]]<-add(release_lrrm(d,g,list(mu=d$mu,V=d$V)),'lrrm_oracle',g)
  rr[[length(rr)+1L]]<-add(release_lrrm(d,g,mom),'lrrm_plugin',g)}
 do.call(rbind,rr)}
# DP sensitivity: every configuration is an ALTERNATIVE mechanism, NOT a
# jointly DP release.  Diagnostics here use the confidential simulated data.
dp_sensitivity_rep<-function(s,z,r){
  set.seed(scenario_seed(s,r)); d<-make_data(z$n,z$T,z$beta3,z$corr)
  H<-score_parts(d)$H
  out<-vector('list',length(EPS_GRID)*length(CLIP_GRID)*2L);j<-0L
  for(epsilon in EPS_GRID)for(B in CLIP_GRID){
    yy<-release_dp_y(d,B,epsilon)
    fit<-gls(d,yy$Y,d$V+diag(yy$noise_sd^2,ncol(d$Y)))
    se<-sqrt(fit$vcov[4,4]); est<-fit$beta[4]
    shift<-gls(d,yy$clipped,d$V+diag(yy$noise_sd^2,ncol(d$Y)))$beta[4]-
      gls(d,d$Y,d$V+diag(yy$noise_sd^2,ncol(d$Y)))$beta[4]
    j<-j+1L;out[[j]]<-data.frame(scenario_id=s,n=z$n,T=z$T,beta3=z$beta3,
      corr=z$corr,rep=r,method='dp_y',epsilon=epsilon,delta=DELTA,clip_bound=B,
      estimate=est,se=se,reject=as.integer(abs(est/se)>Z975),
      cover=as.integer(abs(est-z$beta3)<=Z975*se),clip_rate=yy$rate,
      clip_distortion=yy$distortion,clip_beta_shift=shift,
      noise_sd=yy$noise_sd,noise_beta_sd=NA_real_)
    ss<-release_dp_score(d,B,epsilon)
    j<-j+1L;out[[j]]<-data.frame(scenario_id=s,n=z$n,T=z$T,beta3=z$beta3,
      corr=z$corr,rep=r,method='dp_score',epsilon=epsilon,delta=DELTA,clip_bound=B,
      estimate=ss$est,se=ss$se,reject=as.integer(abs(ss$est/ss$se)>Z975),
      cover=as.integer(abs(ss$est-z$beta3)<=Z975*ss$se),clip_rate=ss$rate,
      clip_distortion=ss$distortion,clip_beta_shift=ss$clip_shift,
      noise_sd=ss$noise_sd,noise_beta_sd=ss$noise_beta_sd)
  }
  do.call(rbind,out)
}
dp_sensitivity_summary<-function(dat){
 if(!nrow(dat))return(NULL)
 k<-interaction(dat$scenario_id,dat$method,dat$epsilon,dat$clip_bound,drop=TRUE)
 do.call(rbind,lapply(split(dat,k),function(z){
   a<-z[1,c('scenario_id','n','T','beta3','corr','method','epsilon','delta','clip_bound')]
   a$reps<-nrow(z);a$bias<-mean(z$estimate-z$beta3)
   a$rmse<-sqrt(mean((z$estimate-z$beta3)^2))
   a$empirical_sd<-sd_na(z$estimate);a$mean_se<-mean(z$se)
   a$se_ratio<-a$mean_se/a$empirical_sd
   a$type1_or_power<-mean(z$reject);a$coverage<-mean(z$cover)
   a$reject_mcse<-sqrt(a$type1_or_power*(1-a$type1_or_power)/a$reps)
   a$coverage_mcse<-sqrt(a$coverage*(1-a$coverage)/a$reps)
   a$mean_clip_rate<-mean(z$clip_rate)
   a$mean_clip_distortion<-mean(z$clip_distortion)
   a$mean_clip_beta_shift<-mean(z$clip_beta_shift)
   a$mean_noise_sd<-mean(z$noise_sd)
   a$mean_noise_beta_sd<-mean_na(z$noise_beta_sd)
   a
 }))
}
mean_na<-function(x)if(!length(x)||all(is.na(x)))NA_real_ else mean(x,na.rm=TRUE)
sd_na<-function(x)if(sum(is.finite(x))<2)NA_real_ else sd(x[is.finite(x)])
summary_method<-function(dat){key<-c('scenario_id','n','T','beta3','corr','method','gamma')
 group<-interaction(dat$scenario_id,dat$method,ifelse(is.na(dat$gamma),'NA',as.character(dat$gamma)),drop=TRUE)
 do.call(rbind,lapply(split(dat,group),function(z){a<-z[1,key,drop=FALSE];a$reps<-nrow(z)
  a$bias<-mean(z$estimate-z$beta3);a$rmse<-sqrt(mean((z$estimate-z$beta3)^2))
  a$empirical_sd<-sd(z$estimate);a$mean_se<-mean_na(z$se_analytic)
  a$se_ratio<-a$mean_se/a$empirical_sd
  for(k in c('reject','cover','reject_boot','cover_boot','clip_rate','clip_distortion',
             'clip_beta_shift','dp_beta_noise_sd','gamma1_beta_maxdiff','gamma1_se_diff',PR_NAMES)){
    a[[paste0('mean_',k)]]<-mean_na(z[[k]])
    a[[paste0('n_',k)]]<-sum(is.finite(z[[k]]))}
  a$boot_n<-sum(is.finite(z$se_boot));a$mean_boot_se<-mean_na(z$se_boot)
  a$boot_se_ratio<-a$mean_boot_se/a$empirical_sd
  zb<-z[is.finite(z$se_boot),,drop=FALSE]
  a$boot_subset_empirical_sd<-sd_na(zb$estimate)
  a$boot_subset_analytic_se<-mean_na(zb$se_analytic)
  a$boot_subset_analytic_se_ratio<-a$boot_subset_analytic_se/a$boot_subset_empirical_sd
  a$boot_subset_se_ratio<-a$mean_boot_se/a$boot_subset_empirical_sd
  a$boot_subset_analytic_coverage<-mean_na(zb$cover)
  a$boot_subset_bootstrap_coverage<-mean_na(zb$cover_boot)
  a$boot_subset_analytic_rejection<-mean_na(zb$reject)
  a$boot_subset_bootstrap_rejection<-mean_na(zb$reject_boot)
  a$reject_mcse<-sqrt(a$mean_reject*(1-a$mean_reject)/a$reps)
  a$cover_mcse<-sqrt(a$mean_cover*(1-a$mean_cover)/a$reps)
  a$boot_cover_mcse<-if(a$n_cover_boot>0)sqrt(a$mean_cover_boot*(1-a$mean_cover_boot)/a$n_cover_boot) else NA_real_
  a}))}
# Matched methods within SAME confidential dataset, paired squared-error difference.
paired_summary<-function(dat){base<-subset(dat,method=='synthetic_plugin')
 out<-list();j<-0L
 for(g in GAMMA){target<-subset(dat,method=='lrrm_plugin'&gamma==g)
  if(nrow(target)!=nrow(base))stop('Paired rows missing')
  aa<-merge(target[,c('rep','estimate','beta3')],base[,c('rep','estimate')],by='rep',suffixes=c('_lrrm','_syn'))
  dif<-(aa$estimate_lrrm-aa$beta3)^2-(aa$estimate_syn-aa$beta3)^2
  j<-j+1L;out[[j]]<-data.frame(scenario_id=dat$scenario_id[1],n=dat$n[1],T=dat$T[1],
   beta3=dat$beta3[1],corr=dat$corr[1],gamma=g,reps=length(dif),
   mean_mse_difference=mean(dif),paired_mcse=sd(dif)/sqrt(length(dif)),
   ci_lower=mean(dif)-Z975*sd(dif)/sqrt(length(dif)),
   ci_upper=mean(dif)+Z975*sd(dif)/sqrt(length(dif)))}
 do.call(rbind,out)}
# Compare plug-in releases using the same simulated dataset and holdout per replicate.
joint_comparison <- function(dat, summary, paired) {
  metrics <- c('rmse', 'mean_reject', 'mean_cover', 'mean_linkage_practical',
               'mean_mia_auc_practical', 'mean_reconstruction_practical')
  attack_metrics <- c('mia_auc_practical', 'reconstruction_practical')
  synthetic <- subset(dat, method == 'synthetic_plugin')
  synthetic_summary <- subset(summary, method == 'synthetic_plugin')
  rows <- lapply(seq_len(nrow(paired)), function(i) {
    result <- paired[i, , drop = FALSE]
    gamma <- result$gamma
    refraction <- dat[dat$method == 'lrrm_plugin' & dat$gamma %in% gamma, ]
    refraction_summary <- summary[summary$method == 'lrrm_plugin' &
                                  summary$gamma %in% gamma, ]
    result$rejection_metric <- if (result$beta3 == 0) 'type_I_error' else 'power'
    result$release_status <- if (gamma == 1) 'unprotected_reference' else 'perturbed'
    for (metric in metrics) {
      result[[paste0(metric, '_lrrm')]] <- refraction_summary[[metric]]
      result[[paste0(metric, '_synthetic')]] <- synthetic_summary[[metric]]
    }
    attacks <- merge(refraction[, c('rep', attack_metrics)],
                     synthetic[, c('rep', attack_metrics)], by = 'rep',
                     suffixes = c('_lrrm', '_synthetic'))
    for (metric in attack_metrics) {
      difference <- attacks[[paste0(metric, '_lrrm')]] -
                    attacks[[paste0(metric, '_synthetic')]]
      difference <- difference[is.finite(difference)]
      count <- length(difference)
      average <- mean_na(difference)
      mcse <- if (count > 1L) sd(difference) / sqrt(count) else NA_real_
      result[[paste0(metric, '_pairs')]] <- count
      result[[paste0(metric, '_difference')]] <- average
      result[[paste0(metric, '_ci_lower')]] <- average - Z975 * mcse
      result[[paste0(metric, '_ci_upper')]] <- average + Z975 * mcse
    }
    result
  })
  do.call(rbind, rows)
}

plot_joint_comparison <- function(summary, path) {
  selected <- subset(summary, method=='lrrm_plugin' | grepl('^synthetic_plugin',method))
  selected <- selected[is.finite(selected$mean_mia_auc_practical),,drop=FALSE]
  if (!nrow(selected)) return(invisible(NULL))
  pdf(path,width=11,height=5.5);on.exit(dev.off(),add=TRUE)
  for(sid in unique(selected$scenario_id)) {
    z<-selected[selected$scenario_id==sid,,drop=FALSE]
    par(mfrow=c(1,2),mar=c(5,5,4,1))
    for(metric in c('mean_mia_auc_practical','mean_reconstruction_practical')) {
      x<-z[[metric]];y<-z$rmse;ok<-is.finite(x)&is.finite(y)
      if(!any(ok)){plot.new();next}
      cols<-ifelse(z$method=='lrrm_plugin',4,2)
      plot(x[ok],y[ok],pch=19,col=cols[ok],xlab=metric,ylab='RMSE',
           main=paste('Scenario',sid,'(empirical attack risk)'))
      lab<-ifelse(z$method=='lrrm_plugin',paste0('gamma=',z$gamma),z$method)
      text(x[ok],y[ok],labels=lab[ok],pos=3,cex=.62)
    }
  }
  invisible(NULL)
}
# Use the same risk metric and identical attack-replication set for both methods.
# AUC=0.5 is chance-level discrimination; larger AUC is greater measured risk.
# Matching by mean AUC is exploratory; CI and effective n must be reported.
matched_privacy <- function(dat, tolerance=AUC_TOL) {
  methods<-unique(dat$method)
  syn<-methods[grepl('^synthetic_plugin',methods)]
  out<-list();j<-0L
  for(sm in syn) for(g in GAMMA[GAMMA<1]) {
    a<-dat[dat$method=='lrrm_plugin' & !is.na(dat$gamma) & dat$gamma==g,,drop=FALSE]
    b<-dat[dat$method==sm,,drop=FALSE]
    m<-merge(a[,c('rep','estimate','beta3','mia_auc_practical','reconstruction_practical')],
             b[,c('rep','estimate','mia_auc_practical','reconstruction_practical')],
             by='rep',suffixes=c('_lrrm','_syn'))
    ok<-is.finite(m$mia_auc_practical_lrrm)&is.finite(m$mia_auc_practical_syn)
    v<-m[ok,,drop=FALSE]
    if(!nrow(v))next
    dd<-v$mia_auc_practical_lrrm-v$mia_auc_practical_syn
    risk_diff<-mean(dd);risk_mcse<-if(length(dd)>1)sd(dd)/sqrt(length(dd)) else NA_real_
    # Utility is estimated on all paired replicates; risk on the attacked subset.
    mse_a<-(m$estimate_lrrm-m$beta3)^2
    mse_b<-(m$estimate_syn-m$beta3)^2
    mse_diff<-mse_a-mse_b
    j<-j+1L
    out[[j]]<-data.frame(scenario_id=dat$scenario_id[1],n=dat$n[1],
      T=dat$T[1],beta3=dat$beta3[1],corr=dat$corr[1],synthetic_method=sm,
      gamma=g,utility_pairs=nrow(m),privacy_pairs=nrow(v),
      auc_lrrm=mean(v$mia_auc_practical_lrrm),auc_synthetic=mean(v$mia_auc_practical_syn),
      auc_difference=risk_diff,auc_mcse=risk_mcse,
      auc_ci_lower=risk_diff-Z975*risk_mcse,auc_ci_upper=risk_diff+Z975*risk_mcse,
      matched_point=abs(risk_diff)<=tolerance,
      matched_ci=all(is.finite(c(risk_mcse,risk_diff))) &&
        max(abs(risk_diff-Z975*risk_mcse),abs(risk_diff+Z975*risk_mcse))<=tolerance,
      rmse_lrrm=sqrt(mean(mse_a)),rmse_synthetic=sqrt(mean(mse_b)),
      mse_difference=mean(mse_diff),
      mse_mcse=if(nrow(m)>1)sd(mse_diff)/sqrt(nrow(m)) else NA_real_,
      reconstruction_lrrm=mean_na(v$reconstruction_practical_lrrm),
      reconstruction_synthetic=mean_na(v$reconstruction_practical_syn))
  }
  if(!length(out))return(data.frame())
  do.call(rbind,out)
}
# Empirical Pareto frontier: minimize RMSE and measured membership AUC.
# Inferences about dominance should use uncertainty, not point estimates alone.
frontier_summary <- function(sm) {
  z<-sm[sm$method=='lrrm_plugin' | grepl('^synthetic_plugin',sm$method),,drop=FALSE]
  z<-z[!(z$method=='lrrm_plugin' & z$gamma>=1) &
       is.finite(z$rmse)&is.finite(z$mean_mia_auc_practical),,drop=FALSE]
  if(!nrow(z))return(data.frame())
  z$pareto_nondominated<-FALSE
  for(sid in unique(z$scenario_id)){
    ix<-which(z$scenario_id==sid)
    for(i in ix){
      dominates<-(z$rmse[ix]<=z$rmse[i] &
                  z$mean_mia_auc_practical[ix]<=z$mean_mia_auc_practical[i] &
                 (z$rmse[ix]<z$rmse[i] |
                  z$mean_mia_auc_practical[ix]<z$mean_mia_auc_practical[i]))
      z$pareto_nondominated[i]<-!any(dominates)
    }
  }
  z[,c('scenario_id','n','T','beta3','corr','method','gamma','reps','rmse',
       'mean_reject','mean_cover','mean_mia_auc_practical','n_mia_auc_practical',
       'mean_reconstruction_practical','pareto_nondominated'),drop=FALSE]
}
# Testable algebraic identities and sanity checks, no external packages.
validate_simulation <- function() {
  set.seed(SEED+991L);d<-make_data(100L,5L,.25,'AR1');m<-fit_moments(d)
  y<-release_lrrm(d,1,m)
  f<-gls(d,y,m$V);f0<-gls(d,d$Y,m$V)
  checks<-c(gamma1_identity=identical(y,d$Y),
    gamma1_estimator=max(abs(f$beta-f0$beta))<1e-10,
    covariance_symmetric=max(abs(m$V-t(m$V)))<1e-10,
    covariance_positive=min(eigen(m$V,symmetric=TRUE)$values)>0,
    synthetic_dimension=identical(dim(release_syn(d,m)),dim(d$Y)),
    clipping_bound=all(row_norm(clip_rows(d$Y,10))<=10+1e-8),
    auc_perfect=abs(auc_score(c(3,4),c(1,2))-1)<1e-12,
    auc_chance=abs(auc_score(c(1,4),c(2,3))-.5)<1e-12)
  data.frame(test=names(checks),pass=unname(checks))
}
# Robust restart: every batch is written atomically; finished batches never recomputed.
atomic_csv<-function(x,p){tmp<-paste0(p,'.tmp');write.csv(x,tmp,row.names=FALSE,na='')
 if(file.exists(p))unlink(p);if(!file.rename(tmp,p))stop('Cannot finalize batch ',p)}
combine_csv<-function(paths,dest){con<-file(dest,'wt');on.exit(close(con),add=TRUE)
 first<-TRUE
 for(p in paths){inp<-file(p,'rt');line<-0L
  repeat{v<-readLines(inp,n=10000L,warn=FALSE);if(!length(v))break
   if(!first&&line==0L)v<-v[-1L]
   if(length(v))writeLines(v,con);line<-line+1L}
  close(inp);first<-FALSE}}
