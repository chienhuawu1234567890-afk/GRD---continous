          decide_paths(matrix(c(NA,12),1,2),c(10,10),c(50,100))$reject==1,
          decide_paths(matrix(c(NA,NA),1,2),c(10,10),c(50,100))$unresolved==1)

methods<-c("GRD","Original_IPW","Conventional")
