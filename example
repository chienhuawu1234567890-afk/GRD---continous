atomic_saveRDS <- function(object,file,...) {
  temporary<-tempfile(pattern=".checkpoint_",tmpdir=dirname(file))
  on.exit(unlink(temporary),add=TRUE)
  saveRDS(object,temporary,...)
  if(file.rename(temporary,file)) return(invisible(file))
  # Some platforms do not replace an existing file by rename.
  backup<-paste0(file,".previous")
  if(file.exists(backup)) stop("Unresolved checkpoint backup: ",backup)
  had_old<-file.exists(file)
  if(had_old && !file.rename(file,backup)) stop("Cannot preserve prior checkpoint")
  if(!file.rename(temporary,file)) {
    if(had_old) file.rename(backup,file)
    stop("Checkpoint rename failed: ",file)
