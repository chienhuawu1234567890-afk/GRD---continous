# Check the complete Cartesian product, not just a row count or folder name.
expected <- do.call(rbind,lapply(configs,function(cfg)
 expand.grid(case=cfg$id,scenario=names(sensitivity_configs(cfg)),
   hypothesis=c("null","alternative"),boundary=c("FrozenNominalFS","Brownian"),
   policy=c("GRD","Original","Confirmation"),stringsAsFactors=FALSE)))
key <- function(x) do.call(paste,c(x[c("case","scenario","hypothesis","boundary","policy")],sep="|"))
stopifnot(counter==expected_panels,nrow(metrics)==nrow(expected),
          !anyDuplicated(key(metrics)),setequal(key(metrics),key(expected)),
          all(metrics$M==Meval),all(abs(metrics$rejection_rate-metrics$rejections/metrics$M)<1e-12))
operations <- do.call(rbind,all_operations)
stopifnot(nrow(operations)==expected_panels*2L)
stopifnot(all(vapply(example_results,function(e)
 all(e$report$immutable_routing & e$report$means_match &
 e$report$covariance_match & e$report$wald_match),TRUE)))
# Algebraic count checks for the same-look confirmation subset.
stopifnot(all(operations$C_rejects<=operations$G_rejects),
 all(operations$C_rejects<=operations$O_rejects),
 all(abs(operations$O_reject_C_no_rate-
     (operations$O_rejects-operations$C_rejects)/Meval)<1e-12))
precision <- do.call(rbind,all_bounds)
if(any(precision$low_precision)) warning("Low-precision finite-sample tails remain; inspect diagnostics.")
write.csv(data.frame(expected_panels=expected_panels,completed_panels=counter,
 expected_metric_rows=nrow(expected),observed_metric_rows=nrow(metrics),
 source_copy_verified=identical(unname(tools::md5sum(source_copy)),source_md5),
 eta_grid=paste(vapply(configs,function(x)x$eta,0.0),collapse=";"),
 mode=mode,source_md5=source_md5),file.path(outdir,"completion_audit.csv"),row.names=FALSE)
write_status(if(mode=="full") "COMPLETE_FULL" else "COMPLETE_SMOKE",counter,expected_panels)
writeLines(c(paste("Version:",VERSION_TAG),paste("Mode:",mode),
 paste("Completed panels:",counter),paste("Metrics rows:",nrow(metrics)),
 "Completed simulation is not evidence of prospective DMC feasibility.",
 "Frozen nominal boundaries do not guarantee nuisance-robust control."),
 file.path(outdir,"COMPLETE.txt"))
archive_files<-list.files(outdir,full.names=TRUE,recursive=TRUE)
archive_files<-archive_files[!dir.exists(archive_files) &
 basename(archive_files)!="output_checksums.csv"]
write.csv(data.frame(file=substring(archive_files,nchar(outdir)+2L),
 md5=unname(tools::md5sum(archive_files))),
 file.path(outdir,"output_checksums.csv"),row.names=FALSE)
cat("\nDONE:",normalizePath(outdir),"\n")
cat("PRIMARY RG: first GRD crossing; no original-label efficacy confirmation.\n")
cat("RC outputs describe a secondary policy only.\n")
cat("Delay units: scheduled looks / finalized outcomes, NOT days.\n")
cat("Frozen nominal calibration is not a nuisance-robust guarantee.\n")
if(mode=="smoke") cat("SMOKE ONLY: rerun full before reporting scientific results.\n")

examples<-lapply(example_results,function(e)e$report)
return(invisible(list(outdir=normalizePath(outdir),mode=mode,
 data=example_results[[1]]$restricted_records,
 analysis=do.call(rbind,examples),operating=metrics,
 primary=subset(metrics,policy=="GRD"),
 comparison=do.call(rbind,all_comparisons),operations=operations,
 examples=example_results,boundaries=all_bounds,manifest=do.call(rbind,manifest))))

}

if(sys.nframe()==0L) {
 args<-commandArgs(trailingOnly=TRUE)
 if(length(args)>1L) stop("Use: Rscript GRD_synthetic_IBS_semiblinded_v8.R quick|full")
 invisible(run_example(if(length(args)) args[1] else "quick"))
}
