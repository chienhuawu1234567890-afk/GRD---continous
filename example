spend <- function(t) ifelse(t<=0,0,2*pnorm(-qnorm(1-alpha/2)/sqrt(t)))

# Calibration is independent of evaluation seeds.
# Omnibus d-dimensional Brownian statistic is ||B_d(t)||^2/t, not Z^2 for d>1.
calibrate <- function(d,t,B,seed) {
  set.seed(seed); K<-length(t); state<-matrix(0,B,d); prev<-0
  W<-matrix(NA_real_,B,K)
  for(k in seq_len(K)) {
    state<-state+matrix(rnorm(B*d,sd=sqrt(t[k]-prev)),B,d)
    W[,k]<-rowSums(state^2)/t[k]; prev<-t[k]
  }
  # Identical empirical crossing-budget convention for both calibrators.
  f<-calibrate_method(W,t,"Brownian")
  z<-f$diagnostics
  z$information_fraction<-t
  z$expected_crossings<-z$target_count
  list(boundaries=f$b,diagnostics=z,seed=seed)
}

# Contrasts against the last treatment arm (placebo/reference).
contrast_matrix <- function(g) cbind(diag(g-1),-rep(1,g-1))

# Calculate all scheduled fixed-look statistics for paired simulation.
# Separate diagnostic runs below assess ordinary fixed-look CI coverage.
# These are NOT confidence intervals valid at a random stopping time.
wald_ipw <- function(X,looks,C) {
  K<-length(looks);d<-nrow(C)
  W<-rep(NA_real_,K); contrasts<-matrix(NA_real_,K,d)
  se<-matrix(NA_real_,K,d); failed<-rep(FALSE,K)
  for(k in seq_len(K)) {
    n<-looks[k];x<-X[seq_len(n),,drop=FALSE]
    means<-colMeans(x)
    v<-crossprod(sweep(x,2,means,'-'))/(n-1)
    h<-C%*%v%*%t(C)
    contrasts[k,]<-as.vector(C%*%means)
    diag_h<-diag(h)
    se[k,]<-sqrt(pmax(0,diag_h/n))
    eig<-tryCatch(eigen(h,symmetric=TRUE,only.values=TRUE)$values,
                  error=function(e) rep(NA_real_,d))
    if(any(!is.finite(eig)) || min(eig)<=0 || min(eig)<=max(eig)*1e-10) {
      failed[k]<-TRUE;next
    }
    vct<-contrasts[k,]
    W[k]<-tryCatch(as.numeric(n*crossprod(vct,solve(h,vct))),
                   error=function(e) NA_real_)
    if(!is.finite(W[k]) || W[k]<0) {W[k]<-NA_real_;failed[k]<-TRUE}
  }
  list(W=W,contrasts=contrasts,se=se,failed=failed,empty=rep(FALSE,K))
}

wald_conventional <- function(A,Y,looks,g,C) {
  K<-length(looks);d<-nrow(C)
  W<-rep(NA_real_,K); contrasts<-matrix(NA_real_,K,d)
  se<-matrix(NA_real_,K,d);failed<-rep(FALSE,K);empty<-rep(FALSE,K)
  for(k in seq_len(K)) {
    idx<-seq_len(looks[k]);groups<-split(Y[idx],factor(A[idx],levels=seq_len(g)))
    ns<-lengths(groups);empty[k]<-any(ns==0)
    if(any(ns<2)) {failed[k]<-TRUE;next}
    means<-vapply(groups,mean,0.0)
    vv<-vapply(groups,var,0.0)/ns
    h<-C%*%diag(vv,g)%*%t(C)
    contrasts[k,]<-as.vector(C%*%means)
    se[k,]<-sqrt(pmax(0,diag(h)))
    eig<-tryCatch(eigen(h,symmetric=TRUE,only.values=TRUE)$values,
                  error=function(e) rep(NA_real_,d))
    if(any(!is.finite(eig)) || min(eig)<=0 || min(eig)<=max(eig)*1e-10) {
      failed[k]<-TRUE;next
    }
    vct<-contrasts[k,]
    W[k]<-tryCatch(as.numeric(crossprod(vct,solve(h,vct))),
                   error=function(e) NA_real_)
    if(!is.finite(W[k]) || W[k]<0) {W[k]<-NA_real_;failed[k]<-TRUE}
  }
  list(W=W,contrasts=contrasts,se=se,failed=failed,empty=empty)
}

outcomes <- function(A,delta,m,sigma,model) {
  n<-length(A)
  noise<-switch(model,normal=rnorm(n),
     heavy=rt(n,5)*sqrt(3/5),
     skew=(exp(rnorm(n))-exp(.5))/sqrt(exp(2)-exp(1)),
     stop('Unknown model'))
  m+delta[A]+sigma[A]*noise
}

make_cfg <- function(id,g,N,eta,model="normal",m=0,Delta=0,K=2,
                     sigma=NULL,p=NULL) {
 if(is.null(p)) p <- if(g==3) c(1/6,1/3,1/2) else rep(1/g,g)
 if(is.null(sigma)) sigma <- rep(1,g)
 stopifnot(length(p)==g,length(sigma)==g,all(p>0),abs(sum(p)-1)<1e-9,
           N>=g*3,eta>=0,eta<1)
 looks <- unique(as.integer(round(seq_len(K)*N/K)))
 stopifnot(length(looks)==K,tail(looks,1)==N)
 list(id=id,g=g,N=N,eta=eta,model=model,m=m,Delta=Delta,
      delta=seq(0,Delta,length.out=g),looks=looks,sigma=sigma,p=p)
}
simulate_paths <- function(cfg,M,seed) {
 set.seed(seed)
 g<-cfg$g; N<-cfg$N; K<-length(cfg$looks); C<-contrast_matrix(g)
 Q<-routing(cfg$p,cfg$eta)
 mr<-diag(1/cfg$p,g)%*%solve(Q)
 W <- array(NA_real_,dim=c(M,K,2),
            dimnames=list(NULL,NULL,c("GRD","Conventional")))
 for(r in seq_len(M)) {
   if(r %% 5000L==0L) {cat("  simulation",r,"/",M,"\n");flush.console()}
   A<-sample.int(g,N,replace=TRUE,prob=cfg$p)
   Y<-outcomes(A,cfg$delta,cfg$m,cfg$sigma,cfg$model)
   U<-runif(N); Ast<-integer(N)
   for(i in seq_len(g)) {
     ix<-which(A==i)
     if(length(ix)) Ast[ix]<-findInterval(U[ix],
         c(0,cumsum(Q[,i])),rightmost.closed=TRUE)
   }
   stopifnot(all(Ast>=1L&Ast<=g))
   Xr<-t(mr[,Ast,drop=FALSE])*Y
   W[r,,1]<-wald_ipw(Xr,cfg$looks,C)$W
   W[r,,2]<-wald_conventional(A,Y,cfg$looks,g,C)$W
 }
 W
}


# Conservative empirical first-crossing calibration. Reject only when a
# finite statistic meets a finite threshold. Never turn failed values into
# a -Inf boundary. Ties can make achieved spending lower than the target.
# This limits EMPIRICAL calibration crossings, not true null probability.
calibrate_method <- function(W,t,method) {
 B<-nrow(W); K<-ncol(W); alive<-rep(TRUE,B); b<-rep(Inf,K)
 rows<-vector("list",K);prev<-0
 for(k in seq_len(K)) {
   increment<-spend(t[k])-spend(prev)
   budget<-as.integer(floor(B*increment+1e-10))
   x<-sort(W[alive & is.finite(W[,k]),k],decreasing=TRUE)
   # At most budget first crossings across all B paths.
   if(budget>0L && length(x)>0L) {
     if(budget>=length(x)) b[k]<-min(x) else {
       candidate<-x[budget]
       if(sum(x>=candidate)<=budget) b[k]<-candidate else {
         higher<-x[x>candidate]
         b[k]<-if(length(higher)) min(higher) else Inf
       }
     }
   }
   hit<-alive & is.finite(W[,k]) & W[,k]>=b[k]
   rows[[k]]<-data.frame(method=method,look=k,boundary=b[k],
      target_increment=increment,achieved_increment=mean(hit),
      target_count=B*increment,budget_count=budget,
      achieved_count=sum(hit),survivors=sum(alive),
      finite_survivors=length(x),
      low_precision=B*increment<MIN_EXPECTED_TAIL,
      calibration_mcse=sqrt(mean(hit)*(1-mean(hit))/B),
      insufficient_finite_paths=length(x)<budget)
   stopifnot(sum(hit)<=budget)
   alive[hit]<-FALSE;prev<-t[k]
 }
 list(b=b,diagnostics=do.call(rbind,rows))
}

crossing_matrix <- function(W,b) {
 stopifnot(is.matrix(W),length(b)==ncol(W),!anyNA(b),all(b>=0))
 z<-is.finite(W) & sweep(W,2,b,">=")
 z<-z & matrix(rep(is.finite(b),each=nrow(W)),nrow(W),ncol(W))
 z[is.na(z)]<-FALSE
 z
}
# Primary efficacy function: intentionally accepts no original-label data.
grd_only_paths <- function(Wg,bg,looks) {
 stopifnot(is.matrix(Wg),length(looks)==ncol(Wg),all(diff(looks)>0))
 G<-crossing_matrix(Wg,bg); f<-first_hit(G); K<-length(looks)
 reached<-outer(ifelse(f>0L,f,K),seq_len(K),">=")
 data.frame(reject=as.integer(f>0L),stoplook=f,
   nstop=looks[ifelse(f>0L,f,K)],
   failed_reached=as.integer(rowSums(reached & !is.finite(Wg))>0L),
   unresolved=as.integer(f==0L & !is.finite(Wg[,K])))
}
first_hit <- function(z) {
 f<-max.col(z,ties.method="first")
 f[rowSums(z)==0L]<-0L
 as.integer(f)
}

# RC: at each reached scheduled look, query the original-label statistic
# ONLY if the GRD statistic crosses. If confirmation fails, continue to the
# next scheduled look and query again only if GRD crosses again. Stop at
# first simultaneous crossing. No futility or calendar-time model is added.
policy_paths <- function(Wg,Wo,bg,bo,looks) {
 stopifnot(identical(dim(Wg),dim(Wo)),ncol(Wg)==length(looks))
 G<-crossing_matrix(Wg,bg);O<-crossing_matrix(Wo,bo)
 M<-nrow(G);K<-ncol(G)
 fg<-first_hit(G);fo<-first_hit(O);fc<-first_hit(G & O)
 stopC<-ifelse(fc>0L,fc,K)
 reached<-outer(stopC,seq_len(K),">=")
 requested<-G & reached
 finiteO<-is.finite(Wo)
 nconf<-rowSums(requested)
 failuresG<-rowSums(reached & !is.finite(Wg))>0L
 failuresO<-rowSums(requested & !finiteO)>0L
 # Original-label results outside 'requested' are COUNTERFACTUAL comparisons.
 # They are never made available to the operational RC analyst/DMC stream.
 row<-function(f) data.frame(reject=as.integer(f>0L),stoplook=f,
    nstop=looks[ifelse(f>0L,f,K)])
 dg<-grd_only_paths(Wg,bg,looks);do<-row(fo);dc<-row(fc)
 reachedO<-outer(ifelse(fo>0L,fo,K),seq_len(K),">=")
 do$failed_reached<-as.integer(rowSums(reachedO & !is.finite(Wo))>0L)
 do$unresolved<-as.integer(fo==0L & !is.finite(Wo[,K]))
 dc$confirmation_attempts<-nconf
 dc$confirmation_completed<-rowSums(requested & finiteO)
 dc$confirmation_failed_numeric<-rowSums(requested & !finiteO)
 dc$unconfirmed_signals<-rowSums(requested & !O)
 dc$failed_reached<-as.integer(failuresG|failuresO)
 dc$unresolved<-as.integer(fc==0L &
    (!is.finite(Wg[,K]) | (G[,K] & !is.finite(Wo[,K]))))
 dc$final_unconfirmed_signal<-as.integer(fc==0L & G[,K])
 # End-of-study non-confirmation is an outcome, not missing delay data.
 # Capped delay assigns N (K) if no RC rejection by the horizon.
 dc$delay_N_vs_O_capped<-dc$nstop-do$nstop
 dc$delay_looks_vs_O_capped<-ifelse(fc>0L,fc,K)-ifelse(fo>0L,fo,K)
 dc$delay_N_vs_G_capped<-dc$nstop-dg$nstop
 dc$delay_looks_vs_G_capped<-ifelse(fc>0L,fc,K)-ifelse(fg>0L,fg,K)
 dc$both_C_O_reject<-as.integer(fc>0L & fo>0L)
 dc$both_C_G_reject<-as.integer(fc>0L & fg>0L)
 dc$delay_N_vs_O_both<-ifelse(fc>0L & fo>0L,dc$nstop-do$nstop,NA_real_)
 dc$delay_looks_vs_O_both<-ifelse(fc>0L & fo>0L,fc-fo,NA_real_)
 dc$delay_N_vs_G_both<-ifelse(fc>0L & fg>0L,dc$nstop-dg$nstop,NA_real_)
 dc$delay_looks_vs_G_both<-ifelse(fc>0L & fg>0L,fc-fg,NA_real_)
 dc$O_reject_C_no<-as.integer(fo>0L & fc==0L)
 dc$G_reject_C_no<-as.integer(fg>0L & fc==0L)
 dc$no_signal<-as.integer(fg==0L)
 dc$G_firstlook<-fg;dc$O_firstlook<-fo
 stopifnot(all(dc$reject<=dg$reject),all(dc$reject<=do$reject),
   all(dc$nstop>=dg$nstop),all(dc$nstop>=do$nstop),
   all(dc$confirmation_attempts<=stopC),
   all(dc$confirmation_attempts[dc$reject==1L]>=1L))
 list(GRD=dg,Original=do,Confirmation=dc)
}

# Deterministic regression checks including a confirmation failure followed
# by later success, no GRD signal, and a numerically failed final check.
self_tests <- function() {
 G<-rbind(c(12,12,12),c(1,1,1),c(12,1,12),c(12,12,12))
 O<-rbind(c(1,12,12),c(12,12,12),c(1,1,NA),c(12,NA,NA))
 z<-policy_paths(G,O,rep(10,3),rep(10,3),c(120,240,360))$Confirmation
 stopifnot(z$stoplook[1]==2,z$confirmation_attempts[1]==2,
   z$confirmation_attempts[2]==0,z$reject[2]==0,
   z$unresolved[3]==1,z$failed_reached[4]==0,
   z$confirmation_attempts[4]==1)
 f<-calibrate_method(matrix(NA_real_,200,2),c(.5,1),"failure")
 stopifnot(all(is.infinite(f$b)),all(f$diagnostics$achieved_count==0))
 # A GRD crossing at an earlier look cannot latch into later confirmation.
 q<-policy_paths(matrix(c(12,1,1),1),matrix(c(1,12,12),1),
    rep(10,3),rep(10,3),c(120,240,360))$Confirmation
 stopifnot(q$reject==0L,q$confirmation_attempts==1L)
 for(e in c(0,.15,.30,.50)) {
   Q<-routing(rep(1/3,3),e)
   p<-rep(1/3,3);mu<-c(-.58,-.345,-.11);R<-diag(1/p)%*%solve(Q)
   expected<-numeric(3)
   for(a in 1:3) for(j in 1:3)
     expected<-expected+p[a]*Q[j,a]*R[,j]*mu[a]
   stopifnot(max(abs(expected-mu))<1e-10,
     max(abs(Q%*%p-p))<1e-12)
 }
 cat("Decision and failure-policy self-tests passed.\n")
}
self_tests()
# RG must be invariant to any change in the original-label reference path.
local({
 wg<-rbind(c(12,1,1),c(1,1,1),c(NA,12,NA),c(NA,1,NA))
 looks<-c(120,240,360);bg<-rep(10,3)
 primary<-grd_only_paths(wg,bg,looks)
 for(wo in list(matrix(0,4,3),matrix(100,4,3),matrix(NA_real_,4,3)))
   stopifnot(identical(primary,policy_paths(wg,wo,bg,bg,looks)$GRD))
 stopifnot(identical(primary$stoplook,c(1L,0L,2L,0L)),
   identical(as.numeric(primary$nstop),c(120,360,240,360)),
   primary$failed_reached[3]==1L,primary$unresolved[4]==1L)
 cat("Primary GRD independence and stopping tests passed.\n")
})




# Incremental analysis and a QR-based internal cross-check. This is a
# computational consistency check, NOT independent external validation.
incremental_summary <- function(n,s,ss,C) {
  mu<-s/n; v<-(ss-tcrossprod(s)/n)/(n-1)
  v<-(v+t(v))/2; h<-C%*%v%*%t(C); z<-as.vector(C%*%mu)
  eig<-eigen(h,symmetric=TRUE,only.values=TRUE)$values
  ok<-all(is.finite(eig)) && min(eig)>max(eig)*1e-10 && min(eig)>0
  w<-if(ok) as.numeric(n*crossprod(z,solve(h,z))) else NA_real_
  list(mean=mu,covariance=v,contrast=z,se=sqrt(pmax(0,diag(h)/n)),
       W=w,valid=ok)
}
close_numeric <- function(a,b,tol=1e-8) {
  if(!identical(is.na(a),is.na(b))) return(FALSE)
  good<-is.finite(a)&is.finite(b)
  if(any(is.infinite(a)|is.infinite(b)))
    if(!identical(a[!good],b[!good])) return(FALSE)
  all(abs(a[good]-b[good])<=tol*(1+pmax(abs(a[good]),abs(b[good]))))
}

# Primary synthetic dry run. Original labels are used by the restricted routing
# service only; no original-label efficacy statistic is computed or released.
simulate_one_trial <- function(cfg,bg,seed) {
  set.seed(seed);g<-cfg$g;K<-length(cfg$looks);C<-contrast_matrix(g)
  Q<-routing(cfg$p,cfg$eta);M<-diag(1/cfg$p,g)%*%solve(Q)
  A<-sample.int(g,cfg$N,replace=TRUE,prob=cfg$p)
  Y<-outcomes(A,cfg$delta,cfg$m,cfg$sigma,cfg$model)
  Ast<-rep(NA_integer_,cfg$N);X<-matrix(NA_real_,cfg$N,g)
  sums<-numeric(g);ss<-matrix(0,g,g);prev<-0L
  rows<-details<-timing<-list()
  for(k in seq_len(K)) {
    n<-cfg$looks[k];new<-seq.int(prev+1L,n)
    old<-if(prev>0L) Ast[seq_len(prev)] else integer()
    start<-proc.time()[['elapsed']]
    for(u in new) Ast[u]<-sample.int(g,1L,prob=Q[,A[u]])
    routing_seconds<-proc.time()[['elapsed']]-start
    immutable<-identical(old,if(prev>0L) Ast[seq_len(prev)] else integer())
    stopifnot(immutable,all(!is.na(Ast[seq_len(n)])))
    start<-proc.time()[['elapsed']]
    X[new,]<-t(M[,Ast[new],drop=FALSE])*Y[new]
    batch<-X[new,,drop=FALSE]
    sums<-sums+colSums(batch);ss<-ss+crossprod(batch)
    inc<-incremental_summary(n,sums,ss,C)
    analysis_seconds<-proc.time()[['elapsed']]-start
    start<-proc.time()[['elapsed']]
    direct<-wald_ipw(X[seq_len(n),,drop=FALSE],n,C)
    xfull<-X[seq_len(n),,drop=FALSE]
    h<-C%*%cov(xfull)%*%t(C);z<-as.vector(C%*%colMeans(xfull))
    wqr<-if(inc$valid) as.numeric(n*crossprod(z,qr.solve(h,z))) else NA_real_
    mean_match<-close_numeric(inc$mean,colMeans(xfull))
    covariance_match<-close_numeric(inc$covariance,cov(xfull))
    wald_match<-close_numeric(inc$W,direct$W) && close_numeric(inc$W,wqr)
    stopifnot(mean_match,covariance_match,wald_match)
    check_seconds<-proc.time()[['elapsed']]-start
    G<-is.finite(inc$W) && is.finite(bg[k]) && inc$W>=bg[k]
    rows[[k]]<-data.frame(look=k,N=n,new_records=length(new),eta=cfg$eta,
      W_GRD=inc$W,b_GRD=bg[k],GRD_crossing=G,primary_policy="RG",
      statistical_efficacy_rejection=G,numerical_failure=!is.finite(inc$W),
      disposition=if(G) "GRD_statistical_efficacy_crossing" else
        if(!is.finite(inc$W)) "numerical_failure_no_rejection" else "no_GRD_crossing",
      action=if(G) "stop_formal_efficacy_testing" else if(k==K)
        "end_without_GRD_rejection" else "continue",
      immutable_routing=immutable,means_match=mean_match,
      covariance_match=covariance_match,wald_match=wald_match)
    details[[k]]<-list(look=k,N=n,mean=inc$mean,covariance=inc$covariance,
      contrasts=inc$contrast,SE=inc$se,C=C,QR_W=wqr)
    timing[[k]]<-data.frame(look=k,N=n,routing_seconds=routing_seconds,
      incremental_analysis_seconds=analysis_seconds,internal_check_seconds=check_seconds)
    prev<-n
    if(G) break
  }
  list(report=do.call(rbind,rows),details=details,timing=do.call(rbind,timing),
    restricted_records=data.frame(id=seq_len(cfg$N),A=A,Y=Y,Ast=Ast),
    seed=seed,cfg=cfg,Q=Q,epsilon=privacy(Q),bg=bg,
    scope="Synthetic RG-only technical dry run; no independent external or DMC validation.")
}
write_example <- function(cfg,fit,seed,outdir) {
  # Example always uses frozen nominal finite-sample boundaries.
  ex<-simulate_one_trial(cfg,fit$GRD$b,seed)
  prefix<-file.path(outdir,paste0("example_",cfg$id))
  start<-proc.time()[['elapsed']]
  write.csv(ex$report,paste0(prefix,"_DMC_report.csv"),row.names=FALSE)
  atomic_saveRDS(ex$details,paste0(prefix,"_analysis_details.rds"))
  report_seconds<-proc.time()[['elapsed']]-start
  write.csv(ex$timing,paste0(prefix,"_timings.csv"),row.names=FALSE)
  write.csv(data.frame(seed=seed,selection="First trial at prespecified seed; no outcome search",
    boundary_scheme="FrozenNominalFS",epsilon=ex$epsilon,
    report_write_seconds=report_seconds,
    independent_external_validation=FALSE,DMC_acceptance_evaluated=FALSE),
    paste0(prefix,"_metadata.csv"),row.names=FALSE)
  restricted<-file.path(outdir,"restricted_synthetic_examples")
  dir.create(restricted,showWarnings=FALSE)
  atomic_saveRDS(ex,file.path(restricted,paste0(cfg$id,"_restricted.rds")))
  # These files contain original labels and routing realization. Never treat
  # the restricted archive as a DP-protected operational release.
  invisible(ex)
}

# Exact contribution covariance under independent allocation:
# E[XX'] = P^-1 Q^-1 diag(Q P m2) Q^-T P^-1.
contribution_moments <- function(cfg) {
  mu<-cfg$m+cfg$delta; Q<-routing(cfg$p,cfg$eta)
  M<-diag(1/cfg$p,cfg$g)%*%solve(Q)
  second_dest<-as.vector(Q%*%(cfg$p*(cfg$sigma^2+mu^2)))
  v<-M%*%diag(second_dest,cfg$g)%*%t(M)-tcrossprod(mu)
  list(mean=mu,covariance=v)
}
fixed_look_diagnostics <- function(cfg,M,seed,outdir) {
  # Independent diagnostic replicates, unrelated to calibration/evaluation.
  # Both null and alternative; only nominal normal nuisance configuration.
  set.seed(seed);g<-cfg$g;K<-length(cfg$looks);C<-contrast_matrix(g)
  Q<-routing(cfg$p,cfg$eta);R<-diag(1/cfg$p,g)%*%solve(Q)
  rows<-list();covrows<-list()
  for(hypothesis in c("null","alternative")) {
    ev<-cfg;if(hypothesis=="null") {ev$Delta<-0;ev$delta<-rep(0,g)}
    truth<-as.vector(C%*%(ev$m+ev$delta));moment<-contribution_moments(ev)
    est<-ses<-array(NA_real_,c(M,K,g-1));vc<-array(NA_real_,c(M,K,g,g))
    for(r in seq_len(M)) {
      A<-sample.int(g,ev$N,TRUE,prob=ev$p)
      Y<-outcomes(A,ev$delta,ev$m,ev$sigma,ev$model)
      Ast<-vapply(A,function(a) sample.int(g,1L,prob=Q[,a]),1L)
      X<-t(R[,Ast,drop=FALSE])*Y
      d<-wald_ipw(X,ev$looks,C);est[r,,]<-d$contrasts;ses[r,,]<-d$se
      for(k in seq_len(K)) vc[r,k,,]<-cov(X[seq_len(ev$looks[k]),,drop=FALSE])
    }
    for(k in seq_len(K)) {
      for(j in seq_len(g-1)) {
        e<-est[,k,j];se<-ses[,k,j];valid<-is.finite(e)&is.finite(se)&se>0
        covered<-abs(e[valid]-truth[j])<=qnorm(.975)*se[valid]
        rate<-if(any(valid)) mean(covered) else NA_real_
        rows[[length(rows)+1L]]<-data.frame(case=ev$id,hypothesis=hypothesis,
          seed=seed,M=M,look=k,N=ev$looks[k],contrast=j,truth=truth[j],
          bias=mean(e)-truth[j],empirical_SD=sd(e),mean_estimated_SE=mean(se),
          theoretical_SE=sqrt((C%*%moment$covariance%*%t(C))[j,j]/ev$looks[k]),
          coverage=rate,coverage_denominator=sum(valid),invalid_count=sum(!valid),
          coverage_mcse=if(any(valid)) sqrt(rate*(1-rate)/sum(valid)) else NA_real_,
          interpretation="Ordinary fixed-look marginal CI, not post-stopping CI")
      }
      empirical_v<-apply(vc[,k,,,drop=FALSE],c(3,4),mean)
      for(a in seq_len(g)) for(b in seq_len(g))
        covrows[[length(covrows)+1L]]<-data.frame(case=ev$id,hypothesis=hypothesis,
          look=k,N=ev$looks[k],row=a,column=b,
          mean_estimated_contribution_covariance=empirical_v[a,b],
          theoretical_contribution_covariance=moment$covariance[a,b])
    }
  }
  write.csv(do.call(rbind,rows),file.path(outdir,paste0("fixed_look_",cfg$id,".csv")),row.names=FALSE)
  write.csv(do.call(rbind,covrows),file.path(outdir,paste0("covariance_check_",cfg$id,".csv")),row.names=FALSE)
}

# Nominal null calibration is frozen. Validation scenarios retain identical
# allocation/routing/looks but change nuisance means, scales or distribution.
# This is a misspecification study, NOT nuisance-robust boundary construction.
sensitivity_configs <- function(cfg) {
 nominal<-cfg;nominal$model<-"normal";nominal$sigma<-rep(1,cfg$g)
 nominal$Delta<-0;nominal$delta<-rep(0,cfg$g)
 variants<-list(matched=nominal)
 variants$mean_lower<-nominal;variants$mean_lower$m<-nominal$m-1
 variants$mean_higher<-nominal;variants$mean_higher$m<-nominal$m+1
 variants$scale_small<-nominal;variants$scale_small$sigma<-rep(.75,cfg$g)
 variants$scale_large<-nominal;variants$scale_large$sigma<-rep(1.5,cfg$g)
 variants$heteroscedastic<-nominal
 variants$heteroscedastic$sigma<-seq(1,2,length.out=cfg$g)
 variants$heavy_t5<-nominal;variants$heavy_t5$model<-"heavy"
 variants$skew_lognormal<-nominal;variants$skew_lognormal$model<-"skew"
 variants$combined_shift_scale_heavy<-variants$heavy_t5
 variants$combined_shift_scale_heavy$m<-nominal$m+1
 variants$combined_shift_scale_heavy$sigma<-seq(1,2,length.out=cfg$g)
 variants
}

avg <- function(x) if(all(is.na(x))) NA_real_ else mean(x,na.rm=TRUE)
semean <- function(x) {
 x<-x[is.finite(x)];if(length(x)<2L) NA_real_ else sd(x)/sqrt(length(x))
}
summary_rows <- function(cfg,scenario,hypothesis,scheme,pol,seed) {
 common<-data.frame(case=cfg$id,scenario=scenario,hypothesis=hypothesis,
  boundary=scheme,g=cfg$g,N=cfg$N,K=length(cfg$looks),eta=cfg$eta,
  validation_model=cfg$model,validation_common_mean=cfg$m,
  validation_sigma=paste(cfg$sigma,collapse=";"),Delta=cfg$Delta,
  M=Meval,validation_seed=seed)
 rates<-list()
 for(nm in names(pol)) {
   d<-pol[[nm]];n<-nrow(d);nr<-sum(d$reject);ci<-wilson(nr,n)
   rates[[nm]]<-cbind(common,data.frame(policy=nm,rejections=nr,
      rejection_rate=nr/n,mcse=sqrt(nr/n*(1-nr/n)/n),
      ci_low=ci[1],ci_high=ci[2],ESS=mean(d$nstop),
      ESS_mcse=semean(d$nstop),
      analysis_role=if(nm=="GRD") "primary" else if(nm=="Original") "simulation_reference" else "secondary_policy",
      failed_reached_rate=mean(d$failed_reached),unresolved_rate=mean(d$unresolved),
      first_look_rejection=mean(d$stoplook==1L),early_stop=mean(d$stoplook>0 & d$stoplook<length(cfg$looks))))
 }
 d<-pol$Confirmation
 # Expose denominators of every conditional delay. Do not interpret them
 # as unconditional delay or as elapsed calendar time.
 operations<-cbind(common,data.frame(
   confirmation_attempts_mean=avg(d$confirmation_attempts),
   confirmation_attempts_mcse=semean(d$confirmation_attempts),
   confirmation_completed_mean=avg(d$confirmation_completed),
   confirmation_numeric_failures_mean=avg(d$confirmation_failed_numeric),
   any_confirmation_rate=mean(d$confirmation_attempts>0),
   unconfirmed_signals_mean=avg(d$unconfirmed_signals),
   failed_reached_rate=avg(d$failed_reached),unresolved_rate=avg(d$unresolved),
   final_unconfirmed_signal_rate=avg(d$final_unconfirmed_signal),
   O_reject_C_no_rate=avg(d$O_reject_C_no),
   G_reject_C_no_rate=avg(d$G_reject_C_no),
   C_rejects=sum(d$reject),O_rejects=sum(pol$Original$reject),
   G_rejects=sum(pol$GRD$reject),
   no_GRD_signal_rate=avg(d$no_signal)))
 for(ref in c("O","G")) {
   for(unit in c("N","looks")) {
     for(kind in c("capped","both")) {
       v<-paste0("delay_",unit,"_vs_",ref,"_",kind)
       operations[[paste0(v,"_mean")]]<-avg(d[[v]])
       operations[[paste0(v,"_mcse")]]<-semean(d[[v]])
       operations[[paste0(v,"_n")]]<-sum(!is.na(d[[v]]))
     }
   }
   den<-sum(pol[[if(ref=="O") "Original" else "GRD"]]$reject)
   operations[[paste0(ref,"_reject_C_no_conditional")]]<-
     if(den>0) sum(d[[paste0(ref,"_reject_C_no")]])/den else NA_real_
 }
 g<-pol$GRD;o<-pol$Original
 comparison<-cbind(common,data.frame(
   comparison_role="paired_simulation_reference_not_operational_gate",
   GRD_only_rejections=sum(g$reject==1L & o$reject==0L),
   Original_only_rejections=sum(g$reject==0L & o$reject==1L),
   both_rejections=sum(g$reject==1L & o$reject==1L),
   disagreement_rate=mean(g$reject!=o$reject),
   disagreement_mcse=sqrt(mean(g$reject!=o$reject)*(1-mean(g$reject!=o$reject))/nrow(g)),
   mean_N_GRD_minus_Original_capped=mean(g$nstop-o$nstop),
   mcse_N_GRD_minus_Original_capped=semean(g$nstop-o$nstop)))
 list(metrics=do.call(rbind,rates),operations=operations,comparison=comparison)
}

# Focus on the IBS design in the manuscript. All validation variants use
# the same frozen nominal boundaries within eta. Independent allocation.
# For other designs, explicitly replace this list with make_cfg(...) calls.
