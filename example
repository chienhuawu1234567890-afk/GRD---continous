     current<-do.call(rbind,all_metrics)
     write.csv(subset(current,policy=="GRD"),file.path(outdir,"primary_GRD_metrics.csv"),row.names=FALSE)
     write.csv(subset(current,policy=="Confirmation"),file.path(outdir,"secondary_confirmation_metrics.csv"),row.names=FALSE)
     write.csv(do.call(rbind,all_comparisons),file.path(outdir,"GRD_reference_comparison.csv"),row.names=FALSE)
     write.csv(do.call(rbind,all_metrics),file.path(outdir,"policy_metrics.csv"),row.names=FALSE)
     write.csv(do.call(rbind,all_operations),file.path(outdir,"confirmation_and_delay.csv"),row.names=FALSE)
   }
 }
